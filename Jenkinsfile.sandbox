// ============================================================================
// Jenkinsfile.sandbox
// Selective test runner for the sandbox branch.
// Detects which modules changed vs dev and runs only those tests.
// Always runs against STAGING environment.
// ============================================================================

pipeline {
  agent any
  tools { nodejs 'Node22' }

  options {
    ansiColor('xterm')
    timestamps()
    // WHY (2026-09-10): this job always targets the SAME STAGING credentials
    // (see 'Setup Environment' below) — two overlapping builds would race the
    // same shared admin/restricted accounts, the same credential-file class of
    // risk already documented in CLAUDE.md's "Concurrent-Worker Credential
    // File Race" section, just at the Jenkins-job level. No trigger in this
    // file makes concurrent runs likely, but nothing prevented a human from
    // triggering a second "Build Now" while one is still in flight either —
    // not an intentional use case here.
    disableConcurrentBuilds()
    timeout(time: 60, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  environment {
    CI                       = 'true'
    HEADLESS                 = 'true'
    PLAYWRIGHT_BROWSERS_PATH = '/var/jenkins_home/.cache/ms-playwright'
    NAVIGATION_TIMEOUT       = '120000'
    EXPECT_TIMEOUT           = '20000'
    RETRY_COUNT              = '1'
  }

  stages {

    stage('Checkout') {
      steps {
        checkout scm
        echo "Branch: ${env.GIT_BRANCH} | Commit: ${env.GIT_COMMIT}"
      }
    }

    stage('Install') {
      steps {
        sh 'node --version'
        sh 'npm ci'
        sh 'npx playwright install chromium'
      }
    }

    stage('Setup Environment') {
      steps {
        script {
          withCredentials([
            string(credentialsId: 'STAGING_APP_URL',             variable: 'STAGING_APP_URL'),
            string(credentialsId: 'STAGING_API_BASE_URL',        variable: 'STAGING_API_BASE_URL'),
            string(credentialsId: 'STAGING_ADMIN_EMAIL',         variable: 'STAGING_ADMIN_EMAIL'),
            string(credentialsId: 'STAGING_ADMIN_PASSWORD',      variable: 'STAGING_ADMIN_PASSWORD'),
            string(credentialsId: 'STAGING_RESTRICTED_EMAIL',    variable: 'STAGING_RESTRICTED_EMAIL'),
            string(credentialsId: 'STAGING_RESTRICTED_PASSWORD', variable: 'STAGING_RESTRICTED_PASSWORD'),
            string(credentialsId: 'GMAIL_APP_PASSWORD',          variable: 'GMAIL_APP_PASSWORD'),
            string(credentialsId: 'GMAIL_USER',                  variable: 'GMAIL_USER')
          ]) {
            writeFile file: '.env', text: """\
ENV=staging
STAGING_APP_URL=${STAGING_APP_URL}
STAGING_API_BASE_URL=${STAGING_API_BASE_URL}
STAGING_ADMIN_EMAIL=${STAGING_ADMIN_EMAIL}
STAGING_ADMIN_PASSWORD=${STAGING_ADMIN_PASSWORD}
STAGING_RESTRICTED_EMAIL=${STAGING_RESTRICTED_EMAIL}
STAGING_RESTRICTED_PASSWORD=${STAGING_RESTRICTED_PASSWORD}
HEADLESS=true
CI=true
NAVIGATION_TIMEOUT=120000
EXPECT_TIMEOUT=20000
GMAIL_APP_PASSWORD=${GMAIL_APP_PASSWORD}
GMAIL_USER=${GMAIL_USER}
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
NOTIFY_ENABLED=true
REPORT_PATH=reports/playwright-report/results.json
"""
          }
        }
      }
    }

    stage('Clear Auth State') {
      steps {
        sh 'rm -rf src/auth/storageStates/'
        sh 'mkdir -p src/auth/storageStates/'
      }
    }

    stage('Detect Changed Tests') {
      steps {
        script {
          // WHY: fetch dev branch so git diff can compare sandbox vs dev
          sh 'git fetch origin dev'
          def target = sh(
            script: 'BASE_BRANCH=dev bash .github/scripts/detect-tests.sh 2>&1 | tail -1',
            returnStdout: true
          ).trim()
          echo "Detected test target: ${target}"
          env.TEST_TARGET = target
        }
      }
    }

    stage('Run Selective Tests') {
      steps {
        script {
          // WHY set as the very first statement of this stage (2026-09-10):
          // marks that this build genuinely reached test execution, as
          // opposed to being cancelled/failing during an earlier stage
          // (Install/Setup Environment/Detect Changed Tests). post{always{}}
          // below reads this flag to decide whether a missing results.json
          // means "tests never got a chance to run" (skip notification) vs.
          // "tests were attempted but something genuinely prevented a
          // report" (a real infra failure — still alert). Same fix as the
          // base Jenkinsfile — see its own identical WHY comment and
          // .claude/known-issues.md's 2026-09-10 entry.
          env.TESTS_ATTEMPTED = 'true'
          echo "Running: npx playwright test --project=chromium --workers=1 ${env.TEST_TARGET}"
          // WHY the credential binding + BRANCH_NAME derivation (2026-09-04):
          // this is NOT a multibranch job — env.BRANCH_NAME is not
          // Jenkins-native here (only env.GIT_BRANCH, set by the Git plugin
          // during checkout, typically prefixed "origin/"), so it's derived
          // via bash parameter expansion inside the single-quoted sh block
          // below, never Groovy-string-interpolated (same reasoning as the
          // credential itself — a real bound env var, resolved by bash, never
          // appears in a logged command string). See .claude/known-issues.md's
          // dynamic-duration-estimate entry for the full design and for why
          // this file's OWN existing "Sync run history" call below needed the
          // identical fix — confirmed via direct grep that neither ever had a
          // git credential wired, so this push has always failed silently.
          withCredentials([usernamePassword(credentialsId: 'github-credentials', usernameVariable: 'GIT_USERNAME', passwordVariable: 'GIT_TOKEN')]) {
            sh '''
              BRANCH_NAME="${GIT_BRANCH#origin/}"
              ENV=staging WORKERS=1 BRANCH_NAME="$BRANCH_NAME" PIPELINE_TOKEN="$GIT_TOKEN" npm run estimate-duration --silent || true
            '''
          }
          // WHY: Confirmed live (2026-07-07 reporting audit) — dropped the
          // --reporter=line,allure-playwright override, which was replacing (not
          // merging with) playwright.config.ts's full reporter array and silently
          // disabling html/json/MiscErrorReporter here. See Jenkinsfile.qa for the
          // full explanation. archiveArtifacts/publishHTML below already existed
          // and will now actually have html/json/misc-errors.json to publish.
          sh """
            npx playwright test --project=chromium --workers=1 ${env.TEST_TARGET}
          """
        }
      }
      post {
        always {
          sh 'mv reports/allure-results allure-results-sandbox || true'
          allure([
            includeProperties: false,
            jdk: '',
            results: [[path: 'allure-results-sandbox']]
          ])
        }
      }
    }

  }

  post {
    always {
      archiveArtifacts(
        artifacts: 'reports/**,test-results/**',
        allowEmptyArchive: true
      )
      publishHTML(target: [
        allowMissing         : true,
        alwaysLinkToLastBuild: true,
        keepAll              : true,
        reportDir            : 'reports/playwright-report',
        reportFiles          : 'index.html',
        reportName           : 'Playwright HTML Report — Sandbox'
      ])
      script {
        try {
          // WHY: see Jenkinsfile (main) for the full explanation — must run
          // before notify so its delta output exists in time for the email.
          // WHY the credential binding + BRANCH_NAME derivation (2026-09-04):
          // same fix, same root cause, as this file's own "Run Selective
          // Tests" stage above — this call had never had a git credential
          // wired (confirmed via direct grep across every Jenkinsfile), so
          // every push here has always failed silently. Not multibranch, so
          // BRANCH_NAME is derived from env.GIT_BRANCH the same way.
          withCredentials([usernamePassword(credentialsId: 'github-credentials', usernameVariable: 'GIT_USERNAME', passwordVariable: 'GIT_TOKEN')]) {
            sh '''
              BRANCH_NAME="${GIT_BRANCH#origin/}"
              WORKERS=1 BRANCH_NAME="$BRANCH_NAME" PIPELINE_TOKEN="$GIT_TOKEN" npm run history:sync || true
            '''
          }
        } catch (e) {
          echo 'History sync failed — continuing'
        }
        // WHY gated on TESTS_ATTEMPTED, not unconditional (2026-09-10): see
        // the base Jenkinsfile's identical WHY comment — without this, a
        // build that never reached 'Run Selective Tests' (cancelled/failed
        // during Install/Setup Environment/Detect Changed Tests) still hits
        // NotificationService's "Report not found" alert, even though no
        // report was ever supposed to exist for that build. Full
        // investigation: .claude/known-issues.md's 2026-09-10 entry.
        if (env.TESTS_ATTEMPTED == 'true') {
          try {
            sh 'npm run notify || true'
          } catch (e) {
            echo 'Notification failed — continuing'
          }
        } else {
          echo 'Run Selective Tests never started for this build — skipping notification to avoid a false "no report" alert for a build that never reached test execution.'
        }
      }
      cleanWs()
    }
    success {
      echo '✅ Sandbox selective tests passed'
    }
    failure {
      echo '❌ Sandbox tests failed — fix before merging to dev'
    }
    unstable {
      echo '⚠️ Sandbox tests unstable — check report'
    }
  }
}
