pipeline {
  agent any
  tools { nodejs 'Node22' }

  options {
    ansiColor('xterm')
    timestamps()
    timeout(time: 150, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  environment {
    CI                       = 'true'
    PROD_APP_URL             = credentials('PROD_APP_URL')
    PROD_API_BASE_URL        = credentials('PROD_API_BASE_URL')
    PROD_ADMIN_EMAIL         = credentials('PROD_ADMIN_EMAIL')
    PROD_ADMIN_PASSWORD      = credentials('PROD_ADMIN_PASSWORD')
    PROD_RESTRICTED_EMAIL    = credentials('PROD_RESTRICTED_EMAIL')
    PROD_RESTRICTED_PASSWORD = credentials('PROD_RESTRICTED_PASSWORD')
    DEFAULT_TIMEOUT          = '30000'
    NAVIGATION_TIMEOUT       = '120000'
    EXPECT_TIMEOUT           = '20000'
    HEADLESS                 = 'true'
    WORKERS                  = '1'
    RETRY_COUNT              = '1'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        echo "Branch: ${env.GIT_BRANCH} | Commit: ${env.GIT_COMMIT}"
      }
    }

    stage('Install') {
      steps {
        sh 'node --version'
        sh 'npm ci'
        sh 'npx playwright install chromium'
      }
    }

    stage('⚠️ Approval — Run PROD?') {
      steps {
        timeout(time: 24, unit: 'HOURS') {
          input message: '🚨 You are about to run tests against PRODUCTION. Are you sure?',
                ok: 'Yes, I approve — run Prod tests',
                submitter: 'akashrn1801',
                parameters: [
                  string(
                    name: 'REASON',
                    defaultValue: '',
                    description: 'Reason for running against Prod (required)'
                  )
                ]
        }
      }
    }

    stage('Test — Prod') {
      steps {
        script {
          // WHY: Dynamic timeout — scales automatically as the suite grows.
          // Calibrated from real CI data (workers=2): ~20 sec/test average,
          // including network calls, setup, and assertions. Plus a 20-minute
          // buffer for checkout/npm install/browser install/report generation.
          // WHY: Count only @prodSafe tests — prod runs a read-only subset, not the full suite
          def testCount = sh(
            script: "grep -rh \"@prodSafe\" tests/ | wc -l",
            returnStdout: true
          ).trim().toInteger()
          def secondsPerTest = 20
          def bufferMinutes = 20
          def computedTimeoutMinutes = (testCount * secondsPerTest + 59) / 60 + bufferMinutes
          echo "Detected ${testCount} @prodSafe tests — dynamic timeout set to ${computedTimeoutMinutes} minutes"
          // WHY additive only, not replacing computedTimeoutMinutes above
          // (2026-09-04) — see Jenkinsfile (main)'s identical WHY comment;
          // same reasoning, applied consistently, with the same production-
          // risk care given this is a PROD pipeline. WHY WORKERS=2 here, not
          // this file's own top-level `environment { WORKERS = '1' }` — see
          // Jenkinsfile.qa's identical WHY comment on this exact same
          // pre-existing, dead env-value inconsistency.
          withCredentials([usernamePassword(credentialsId: 'github-credentials', usernameVariable: 'GIT_USERNAME', passwordVariable: 'GIT_TOKEN')]) {
            sh '''
              BRANCH_NAME="${GIT_BRANCH#origin/}"
              ENV=prod WORKERS=2 BRANCH_NAME="$BRANCH_NAME" PIPELINE_TOKEN="$GIT_TOKEN" npm run estimate-duration --silent || true
            '''
          }
          timeout(time: computedTimeoutMinutes, unit: 'MINUTES') {
            // WHY: Confirmed live (2026-07-07 reporting audit) — dropped the
            // --reporter=line,allure-playwright override, which was replacing
            // (not merging with) playwright.config.ts's full reporter array and
            // silently disabling html/json/MiscErrorReporter here. See
            // Jenkinsfile.qa for the full explanation — same fix, same reasoning.
            sh '''
              ENV=prod npx playwright test \
                --project=chromium \
                --grep @prodSafe \
                --workers=2
            '''
          }
        }
      }
      post {
        always {
          sh 'mv reports/allure-results allure-results-prod || true'
          allure([
            includeProperties: false,
            jdk: '',
            results: [[path: 'allure-results-prod']]
          ])
        }
      }
    }
  }

  post {
    success  { echo '✅ Prod tests passed' }
    failure  { echo '❌ Prod tests FAILED — investigate immediately' }
    always {
      // WHY: Confirmed live (2026-07-07 reporting audit) — archive before
      // cleanWs() wipes the workspace, same reasoning as Jenkinsfile.qa.
      archiveArtifacts(
        artifacts: 'reports/**,test-results/**',
        allowEmptyArchive: true
      )
      publishHTML(target: [
        allowMissing         : true,
        alwaysLinkToLastBuild: true,
        keepAll              : true,
        reportDir            : 'reports/playwright-report',
        reportFiles          : 'index.html',
        reportName           : 'Playwright HTML Report — Prod'
      ])
      // WHY added 2026-09-04 — see Jenkinsfile.qa's identical WHY comment;
      // this pipeline never had ANY history-ledger wiring before either.
      // history:sync only, not notify — same scoping decision as Jenkinsfile.qa.
      script {
        try {
          withCredentials([usernamePassword(credentialsId: 'github-credentials', usernameVariable: 'GIT_USERNAME', passwordVariable: 'GIT_TOKEN')]) {
            sh '''
              BRANCH_NAME="${GIT_BRANCH#origin/}"
              ENV=prod WORKERS=2 BRANCH_NAME="$BRANCH_NAME" PIPELINE_TOKEN="$GIT_TOKEN" npm run history:sync || true
            '''
          }
        } catch (e) {
          echo 'History sync failed — continuing'
        }
      }
      cleanWs()
    }
  }
}