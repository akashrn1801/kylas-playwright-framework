pipeline {
  agent any
  tools { nodejs 'Node22' }

  options {
    ansiColor('xterm')
    timestamps()
    // WHY: Must exceed the dynamic inner-stage timeout computed below (222
    // @regression tests → ~253 min) plus overhead for checkout/install —
    // otherwise this outer ceiling kills the build before the inner timeout
    // ever gets a chance to.
    timeout(time: 300, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  environment {
    CI                     = 'true'
    QA_APP_URL             = credentials('QA_APP_URL')
    QA_API_BASE_URL        = credentials('QA_API_BASE_URL')
    QA_ADMIN_EMAIL         = credentials('QA_ADMIN_EMAIL')
    QA_ADMIN_PASSWORD      = credentials('QA_ADMIN_PASSWORD')
    QA_RESTRICTED_EMAIL    = credentials('QA_RESTRICTED_EMAIL')
    QA_RESTRICTED_PASSWORD = credentials('QA_RESTRICTED_PASSWORD')
    DEFAULT_TIMEOUT        = '30000'
    NAVIGATION_TIMEOUT     = '120000'
    EXPECT_TIMEOUT         = '20000'
    HEADLESS               = 'true'
    WORKERS                = '1'
    RETRY_COUNT            = '1'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        echo "Branch: ${env.GIT_BRANCH} | Commit: ${env.GIT_COMMIT}"
      }
    }

    stage('Install') {
      steps {
        sh 'node --version'
        sh 'npm ci'
        sh 'npx playwright install chromium'
      }
    }

    stage('Test — QA') {
      // WHY: Jenkins is NOT the primary CI for qa branch.
      // GitHub Actions qa.yml handles qa branch exclusively.
      // This pipeline is kept for MANUAL runs only — do not trigger via webhook.
      // To run manually: Jenkins → Build Now (not triggered by push).
      steps {
        script {
          // WHY: Dynamic timeout — scales automatically as the suite grows.
          // Previously calibrated at ~20 sec/test, but a real full-suite local
          // run (235 tests, workers=2, 2.9 hours) measured ~44.4 sec/test —
          // more than double. 20 sec/test made this timeout the actual cause
          // of the pipeline being killed mid-suite, not a symptom of it.
          // Recalibrated to 60 sec/test (~35% margin over the measured rate,
          // to also absorb Jenkins hardware being slower than local) plus a
          // larger buffer. Counts only @regression-tagged tests since that's
          // what this stage runs.
          def testCount = sh(
            script: "grep -rh \"@regression\" tests/ | wc -l",
            returnStdout: true
          ).trim().toInteger()
          def secondsPerTest = 60
          def bufferMinutes = 30
          def computedTimeoutMinutes = (testCount * secondsPerTest + 59) / 60 + bufferMinutes
          echo "Detected ${testCount} @regression tests — dynamic timeout set to ${computedTimeoutMinutes} minutes"
          // WHY additive only, not replacing computedTimeoutMinutes above
          // (2026-09-04) — see Jenkinsfile (main)'s identical WHY comment;
          // same reasoning, applied consistently. WHY WORKERS=2 here, not
          // this file's own top-level `environment { WORKERS = '1' }`
          // (2026-09-04, found while implementing this): that env-level value
          // is dead — the actual test run below passes --workers=2 as an
          // explicit CLI flag, which always wins over a WORKERS env var per
          // this repo's own documented convention (CLAUDE.md rule 23). Using
          // the stale env value here would tag every history record with the
          // wrong concurrency, silently corrupting future estimates for this
          // branch — not fixed here (out of scope, a separate pre-existing
          // inconsistency), just not propagated into new code.
          withCredentials([usernamePassword(credentialsId: 'github-credentials', usernameVariable: 'GIT_USERNAME', passwordVariable: 'GIT_TOKEN')]) {
            sh '''
              BRANCH_NAME="${GIT_BRANCH#origin/}"
              ENV=qa WORKERS=2 BRANCH_NAME="$BRANCH_NAME" PIPELINE_TOKEN="$GIT_TOKEN" npm run estimate-duration --silent || true
            '''
          }
          timeout(time: computedTimeoutMinutes, unit: 'MINUTES') {
            // WHY: Confirmed live (2026-07-07 reporting audit) — this used to pass
            // --reporter=line,allure-playwright, which REPLACES (not merges with)
            // playwright.config.ts's full reporter array. That silently disabled
            // the html/json reporters and MiscErrorReporter on every Jenkins-run
            // branch, so no results.json, no misc-errors.json, no HTML report ever
            // existed here — only a bare terminal list and Allure. Dropping the
            // override lets the config's full array run, matching what GitHub
            // Actions already gets for this same branch. Allure results now land
            // at reports/allure-results (per playwright.config.ts's CI path)
            // instead of allure-playwright's own bare ./allure-results default —
            // see the `mv` line below, updated to match.
            sh '''
              ENV=qa npx playwright test \
                --project=chromium \
                --grep @regression \
                --workers=2
            '''
          }
        }
      }
      post {
        always {
          sh 'mv reports/allure-results allure-results-qa || true'
          allure([
            includeProperties: false,
            jdk: '',
            results: [[path: 'allure-results-qa']]
          ])
        }
      }
    }
  }

  post {
    success  { echo '✅ QA tests passed' }
    failure  { echo '❌ QA tests failed' }
    always {
      // WHY: Confirmed live (2026-07-07 reporting audit) — without archiving
      // before cleanWs() below wipes the workspace, the html/json/misc-errors
      // reports restored above would be generated and then immediately
      // destroyed, making the reporter fix a no-op in practice. Matches the
      // archive+publish pattern already used by Jenkinsfile/Jenkinsfile.sandbox.
      archiveArtifacts(
        artifacts: 'reports/**,test-results/**',
        allowEmptyArchive: true
      )
      publishHTML(target: [
        allowMissing         : true,
        alwaysLinkToLastBuild: true,
        keepAll              : true,
        reportDir            : 'reports/playwright-report',
        reportFiles          : 'index.html',
        reportName           : 'Playwright HTML Report — QA'
      ])
      // WHY added 2026-09-04 — this pipeline never had ANY history-ledger
      // wiring before (confirmed via grep: no history:sync call anywhere in
      // this file, unlike Jenkinsfile/Jenkinsfile.sandbox). Deliberately
      // history:sync ONLY, not also notify/email — that needs its own GMAIL_*
      // credential binding this pipeline has never had either, and wiring up
      // email notifications for a pipeline that's never sent any is a
      // separate, bigger decision than this feature's own scope (a duration
      // estimate only needs the write side to function). Mirrors
      // Jenkinsfile/Jenkinsfile.sandbox's existing try/catch shape exactly.
      script {
        try {
          withCredentials([usernamePassword(credentialsId: 'github-credentials', usernameVariable: 'GIT_USERNAME', passwordVariable: 'GIT_TOKEN')]) {
            sh '''
              BRANCH_NAME="${GIT_BRANCH#origin/}"
              ENV=qa WORKERS=2 BRANCH_NAME="$BRANCH_NAME" PIPELINE_TOKEN="$GIT_TOKEN" npm run history:sync || true
            '''
          }
        } catch (e) {
          echo 'History sync failed — continuing'
        }
      }
      cleanWs()
    }
  }
}